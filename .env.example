# Copie para .env e ajuste. O .env nunca vai para o git.

# Endereco e porta. 0.0.0.0 aceita o celular na mesma rede; 127.0.0.1 so o proprio PC.
NEXDECK_HOST=0.0.0.0
NEXDECK_PORT=3210

# Espelhamento da tela do PC no celular (mostra tudo que esta na tela). Desligado por padrao.
NEXDECK_SCREEN_STREAM=false

# Ponte com o Nextor (opcional). Mesmo token do NEXTOR_TOKEN do Nextor.
NEXDECK_NEXTOR_URL=http://localhost:5005
NEXDECK_NEXTOR_TOKEN=

# Pasta dos dados locais (token de pareamento, deck, acoes personalizadas).
# NEXDECK_DATA_DIR=
